# my.cnf
[mysqld]
# 服务器默认时区
default-time-zone='Asia/Shanghai'

# NGRAM 全文解析器的 token 大小 
# 通常用于CJK（中日韩）语言的全文搜索
ngram_token_size=2

# 默认存储引擎
default-storage-engine=INNODB

# 服务器默认字符集
character-set-server=utf8mb4

# 服务器默认排序规则
#collation-server=utf8mb4_general_ci
collation-server=utf8mb4_unicode_ci

# 如果 character-set-server 等已正确设置，客户端通常会自动协商正确的字符集，此行可能不是必需的，但保留无害
init_connect='SET NAMES utf8mb4'

# 启用二进制日志
log_bin = true

# 二进制日志文件的保留时间，单位秒
binlog_expire_logs_seconds = 604800

# 表名大小写敏感性
lower_case_table_names = 1

# 启用 mysql_native_password 默认是 caching_sha2_password
# MySQL 8 默认推荐使用更安全的 `caching_sha2_password` 认证插件
#default-authentication-plugin=mysql_native_password

# InnoDB 缓冲池大小
# 根据服务器内存大小调整，通常设置为总内存的 50%-70%。1G 对于小型数据库可能足够
innodb_buffer_pool_size=1G

# InnoDB 重做日志文件大小 
# 较大的值可以减少 I/O 操作，提高写入性能
#innodb_log_file_size=256M
innodb_redo_log_capacity=256M

# InnoDB 重做日志刷新策略
# 0 表示每秒刷新一次
# 1 表示每次事务提交都将日志刷新到磁盘，提供最高数据持久性
# 2 表示每次事务提交写入日志文件，但由操作系统刷新到磁盘
innodb_flush_log_at_trx_commit = 1

# InnoDB 数据文件刷新方法
# O_DIRECT 推荐在专用数据库服务器上使用，避免操作系统的双重缓冲，
# 提高 I/O 性能，尤其是在有硬件 RAID 控制器和电池备份缓存时。
#innodb_flush_method = O_DIRECT

# 告诉 InnoDB 存储设备的 IOPS 能力
# 帮助 InnoDB 调整后台刷新操作的数量
#innodb_io_capacity = 2000

# 当 innodb_buffer_pool_size 很大时（通常 > 1GB），将其分成多个实例可以减少内部锁争用
# 建议设置为 8 或 16，但不能超过 CPU 核心数。
#innodb_buffer_pool_instances = 8 

#  每个 InnoDB 表都存储在单独的 .ibd 文件中
# 便于管理、回收空间和备份单个表
innodb_file_per_table = ON

# 启用慢查询日志
slow_query_log=1

# 慢查询日志文件路径
slow_query_log_file=/var/log/mysql/slow.log

# 记录执行时间超过此秒数的查询。建议根据应用响应时间要求进行调整
long_query_time=2

# 错误日志文件路径
# log_error=/var/log/mysql/error.log

# 通用查询日志
# 生产环境通常保持关闭。记录所有客户端连接和执行的语句。
# 开启会产生大量 I/O 并显著降低性能。仅在调试时短暂开启。
#general_log = OFF 
#general_log_file = /var/log/mysql/general.log


# 主机缓存大小。设置为 0 表示禁用主机缓存。
# 配合 `skip-name-resolve` 使用时，可以避免 DNS 解析开销，但意味着所有用户授权都必须使用 IP 地址。
host_cache_size=0

# 禁用 DNS 解析
skip-name-resolve

# 表定义缓存大小。用于缓存表的元数据（例如表结构）。
table_definition_cache=400

# 表打开缓存大小。用于缓存打开的表文件句柄。
table_open_cache=256
# off会节省cpu和内存 但是会无法使用诊断工具
performance_schema = on

# 内存中临时表的最大大小。如果查询需要大量临时表（如 GROUP BY、ORDER BY），
# 可以适当增大此值以减少磁盘 I/O。超过此大小的临时表会转储到磁盘。
tmp_table_size = 128M # 根据查询负载调整，建议与 max_heap_table_size 保持一致
max_heap_table_size = 128M # 根据查询负载调整，建议与 tmp_table_size 保持一致

# 每个线程用于排序操作的缓冲区大小。对于需要大量排序的查询，适当增大有助于性能。
# 但是这是每个连接的，设置过大可能导致内存耗尽（max_connections * sort_buffer_size）。
sort_buffer_size = 4M # 根据查询中排序操作的频率和数据量调整

# 每个线程用于全表扫描的连接操作的缓冲区大小。对于不使用索引的 join 操作有帮助。
# 同样是每个连接的，设置需谨慎。
join_buffer_size = 4M # 根据查询中 join 操作的频率和类型调整

# 线程缓存大小。客户端断开连接时，线程会放入缓存而不是销毁，减少新连接的创建开销。
# 建议设置为 max_connections 的 10%-20%，或根据系统负载观察。
thread_cache_size = 128 # 根据并发连接数和服务器资源调整

# MySQL 允许打开的最大文件句柄数。确保操作系统也允许足够大的限制（例如通过 ulimit -n）。
# 如果遇到 "Too many open files" 错误，需要同时调整此参数和操作系统限制。
open_files_limit = 65535 # 确保操作系统也支持此值，避免文件句柄不足


# 允许的最大并发连接数
max_connections = 2000

# 单个用户允许的最大并发连接数
max_user_connections= 500

# 交互式连接（例如通过 `mysql` 命令行客户端）的超时时间，单位秒。
interactive_timeout = 3600

# 非交互式连接（例如应用程序连接池）的超时时间，单位秒。
wait_timeout = 3600

# SQL 模式。STRICT_TRANS_TABLES 是推荐的严格模式，有助于数据完整性
sql_mode='STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION'


[client]
# 客户端连接的默认字符集
default-character-set=utf8mb4

[mysql]
# mysql 命令行客户端的默认字符集
default-character-set=utf8mb4

